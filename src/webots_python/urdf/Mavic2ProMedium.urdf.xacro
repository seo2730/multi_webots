<?xml version="1.0"?>
<!-- Mavic2ProMedium (중형급 쿼드콥터) URDF.
     SummitXlSteel.urdf.xacro와 같은 방식으로 webots_ros2_driver에 플러그인을 물린다.
     기체 실물 형상은 Webots PROTO가 그리므로 여기서는 TF 뼈대만 정의한다. -->
<robot name="drone" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="namespace" default=""/>

  <!-- 동체: 대각선 약 0.7 m (순정 Mavic의 2배) -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.17 0.054"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.17 0.054"/>
      </geometry>
    </collision>
  </link>

  <!-- 짐벌 카메라: 동체 앞쪽 아래 -->
  <link name="camera"/>
  <joint name="base_link_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera"/>
    <origin xyz="0.09 0 -0.05" rpy="0 0 0"/>
  </joint>

  <link name="gps"/>
  <joint name="base_link_gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="inertial_unit"/>
  <joint name="base_link_inertial_unit_joint" type="fixed">
    <parent link="base_link"/>
    <child link="inertial_unit"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gyro"/>
  <joint name="base_link_gyro_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gyro"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="compass"/>
  <joint name="base_link_compass_joint" type="fixed">
    <parent link="base_link"/>
    <child link="compass"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 라이다: 동체 위 0.12 m. Mavic2ProMediumSensorized.proto 의 bodySlot 위치와
       **같아야 한다** — 여기가 어긋나면 스캔이 실제와 다른 곳에서 나온 것처럼 변환되어
       SLAM 이 조용히 틀린 맵을 그린다. 그 높이를 왜 0.12 로 골랐는지는 PROTO 주석 참고. -->
  <link name="Velodyne_VLP_16">
    <visual>
      <geometry>
        <cylinder radius="0.052" length="0.0727"/>
      </geometry>
    </visual>
  </link>
  <joint name="base_link_Velodyne_VLP_16_joint" type="fixed">
    <parent link="base_link"/>
    <child link="Velodyne_VLP_16"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- 하향 뎁스센서: 동체 아래 0.12 m, 정면(+x)이 아래(-z)를 보도록 y축 +90° 회전.
       PROTO 의 배치와 **같아야 한다** (라이다와 같은 이유). -->
  <link name="down_depth"/>
  <joint name="base_link_down_depth_joint" type="fixed">
    <parent link="base_link"/>
    <child link="down_depth"/>
    <origin xyz="-0.12 0 -0.12" rpy="0 1.5708 0"/>
  </joint>

  <webots>
    <plugin type="simulator.drone_driver.main">
      <namespace>$(arg namespace)</namespace>
    </plugin>

    <!-- 라이다는 Mavic2ProMediumSensorized.proto 에만 있다. 순정 Mavic2ProMedium 을
         손으로 놓고 이 URDF 를 쓰면 드라이버가 "device not found" 경고만 내고 넘어간다
         (치명적이지 않지만 그 드론은 SLAM 을 못 돌린다). -->
    <device reference="Velodyne_VLP_16" type="Lidar">
      <ros><frameName>$(arg namespace)/Velodyne_VLP_16</frameName></ros>
    </device>

    <!-- 하향 뎁스센서. 층 선택기가 /{ns}/down_depth/point_cloud 로 발밑을 본다. -->
    <device reference="down_depth" type="RangeFinder">
      <ros>
        <topicName>/$(arg namespace)/down_depth</topicName>
        <frameName>$(arg namespace)/down_depth</frameName>
        <enabled>true</enabled>
      </ros>
    </device>

    <device reference="camera" type="Camera">
      <ros>
        <topicName>/$(arg namespace)/camera</topicName>
        <frameName>$(arg namespace)/camera</frameName>
        <enabled>true</enabled>
      </ros>
    </device>

    <device reference="gps" type="GPS">
      <ros>
        <frameName>$(arg namespace)/gps</frameName>
      </ros>
    </device>
  </webots>
</robot>
