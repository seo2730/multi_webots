# 실행 중인 Webots 시뮬레이션에 로봇 한 대를 추가한다.
#
# 사용 예 (한 줄로 입력):
#   ros2 service call /spawn_robot webots_spawner_msgs/srv/SpawnRobot "{type: 'drone', random: true}"
#   ros2 service call /spawn_robot webots_spawner_msgs/srv/SpawnRobot "{type: 'drone', x: 3.0, y: -2.0, yaw: 1.57}"
#
# 주의: 이 파일의 주석에 역슬래시를 쓰지 말 것. rosidl 이 주석을 IDL 주석으로 옮기면서
# 줄 끝 역슬래시를 이스케이프로 해석해 빌드가 UnicodeDecodeError 로 깨진다.

# 로봇 종류: 'ugv' | 'spot' | 'drone'
string type

# 로봇 이름 겸 ROS 2 네임스페이스. 비우면 씬 트리를 보고 자동 채번한다(drone2, drone3 ...).
string robot_id

# true면 아래 x/y/yaw를 무시하고 /map_merged의 빈 공간에서 자리를 고른다.
bool random

# random=false일 때 쓰는 목표 위치(world 프레임, 미터/라디안).
# z는 로봇 종류마다 정해진 값을 쓰므로 받지 않는다.
float64 x
float64 y
float64 yaw

# 주변에 이만큼(m)은 비어 있어야 한다. 0이면 로봇 종류별 기본값을 쓴다.
# random=false일 때도 검사하며, 통과 못 하면 force가 아닌 한 거절한다.
float64 min_clearance

# true면 빈 공간 검사 결과와 무관하게 요청한 자리에 그대로 놓는다.
# random=true와 함께 쓰면 무시된다.
bool force

---

bool success

# 실제로 부여된 이름과 놓인 자리. 실패 시 robot_id는 비어 있을 수 있다.
string robot_id
float64 x
float64 y
float64 yaw

# 성공/실패 사유. 실패했을 때 여기만 보면 원인을 알 수 있게 채운다.
string message
